# --- Application ---
APP_ENV=demo                      # demo | production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- Webhook signing secrets (one per provider; replace with real secrets) ---
VOICE_WEBHOOK_SECRET=change-me-voice-secret
CHAT_WEBHOOK_SECRET=change-me-chat-secret
SIGNATURE_TOLERANCE_SECONDS=300

# --- CRM destination: fake (in-memory) | http ---
CRM_BACKEND=fake
CRM_BASE_URL=http://localhost:9999
CRM_API_TOKEN=change-me-crm-token
CRM_TIMEOUT_SECONDS=10
CRM_MAX_RETRIES=3

# --- Idempotency store: memory | redis ---
IDEMPOTENCY_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
IDEMPOTENCY_LOCK_TTL_SECONDS=600

# --- Blob storage: local | s3 ---
BLOB_BACKEND=local
LOCAL_BLOB_DIR=./var/blobs
S3_BUCKET=webhook-relay-recordings
S3_ENDPOINT_URL=http://localhost:9000     # MinIO / LocalStack; leave empty for AWS
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Media download guard-rails ---
MEDIA_MAX_BYTES=26214400          # 25 MiB
MEDIA_TIMEOUT_SECONDS=20
MEDIA_ALLOWED_CONTENT_TYPES=audio/mpeg,audio/wav,audio/x-wav,audio/ogg,audio/mp4
